rules_version = '2';

// Penulisan data SELALU lewat Worker (service account); klien hanya boleh membaca sesuai izin role.
// Default menolak semua.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Akun Google "sementara" (belum terdaftar) tidak punya dokumen users, sehingga ditolak di sini.
    function active() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.disabled == false;
    }

    function myRole() {
      return get(/databases/$(database)/documents/roles/$(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.roleId)).data;
    }

    function can(perm) {
      return active() && (perm in myRole().perms);
    }

    // Profil: pemiliknya selalu boleh membaca (juga bila dinonaktifkan, agar aplikasi dapat menampilkan
    // pesan). Pemegang izin "users" hanya boleh membaca akun berlevel di bawahnya; kueri klien wajib
    // memakai where('level', '<', levelSendiri).
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow get, list: if can('users') && resource.data.level < myRole().level;
      allow create, update, delete: if false;
    }

    // Daftar role dan izinnya: untuk akun terdaftar yang aktif.
    match /roles/{roleId} {
      allow get, list: if active();
      allow write: if false;
    }

    // Permintaan reset: hanya role di atas pemohon (kueri: where('requesterLevel', '<', levelSendiri)).
    match /resetRequests/{id} {
      allow get, list: if can('resets') && resource.data.requesterLevel < myRole().level;
      allow write: if false;
    }

    // Log audit: hanya untuk pemegang izin "audit". Tidak ada yang dapat menulis dari klien.
    match /auditLog/{id} {
      allow get, list: if can('audit');
      allow write: if false;
    }

    // Pencarian username dan semua koleksi lain: hanya Worker.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

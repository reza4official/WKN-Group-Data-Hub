{
  "_catatan": "Spesifikasi tangkapan layar panduan. Dipakai e2e/guide-shots.mjs (membuat gambar bernomor di assets/panduan) dan halaman Panduan (legenda). Selector memakai id, aria-label, atau data-guide yang ada di aplikasi; tes memastikan semuanya masih ada.",
  "login": {
    "route": "",
    "caption": "Halaman masuk",
    "marks": [
      { "n": 1, "selector": "#login-username", "label": "Username" },
      {
        "n": 2,
        "selector": "input[autocomplete=current-password]",
        "label": "Password (ikon mata menampilkan/menyembunyikan)"
